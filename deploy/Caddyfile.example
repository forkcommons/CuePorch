# Replace these names with the institution's existing domains.
# Run Caddy on the host that owns both loopback listeners.
watch.example.org {
    reverse_proxy 127.0.0.1:19001
}
video.example.org {
    reverse_proxy 127.0.0.1:19000
}

# Optional Event Series hostname. Set DNS for this name and add it to
# CUEPORCH_EVENT_SERIES_HOSTS in the publishing service environment.
# festival.example.org {
#     reverse_proxy 127.0.0.1:19001
# }
